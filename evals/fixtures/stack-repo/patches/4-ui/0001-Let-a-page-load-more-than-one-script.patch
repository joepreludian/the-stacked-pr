From e4927c334b70cfc8d7037fcd6b61a3a164482b88 Mon Sep 17 00:00:00 2001
From: Fixture <fixture@example.com>
Date: Mon, 5 Oct 2026 09:40:00 -0300
Subject: [PATCH 1/3] Let a page load more than one script

The team screen is about to need a second script for the invites
section. page() takes a tuple of scripts in place of a single name.
---
 app/screens/layout.py       |  8 +++++---
 app/screens/team_members.py |  2 +-
 tests/test_team_screen.py   | 12 ++++++++++++
 3 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/app/screens/layout.py b/app/screens/layout.py
index 8c33ac5..2dfe1ad 100644
--- a/app/screens/layout.py
+++ b/app/screens/layout.py
@@ -9,16 +9,18 @@ NAV = (
 )
 
 
-def page(title, body, script=None):
+def page(title, body, scripts=()):
     links = "".join(f'<a href="{href}">{escape(label)}</a>' for label, href in NAV)
-    script_tag = f'<script src="/static/{escape(script)}" defer></script>' if script else ""
+    script_tags = "\n  ".join(
+        f'<script src="/static/{escape(name)}" defer></script>' for name in scripts
+    )
     return f"""<!doctype html>
 <html lang="en">
 <head>
   <meta charset="utf-8">
   <title>{escape(title)} · Teamdesk</title>
   <link rel="stylesheet" href="/static/app.css">
-  {script_tag}
+  {script_tags}
 </head>
 <body>
   <nav class="topnav">{links}</nav>
diff --git a/app/screens/team_members.py b/app/screens/team_members.py
index f9d7780..e0d246b 100644
--- a/app/screens/team_members.py
+++ b/app/screens/team_members.py
@@ -53,7 +53,7 @@ def render(team_id, members, viewer):
         </tbody>
       </table>
     </section>"""
-    return page("Team settings", body, script="team_members.js" if can_manage else None)
+    return page("Team settings", body, scripts=("team_members.js",) if can_manage else ())
 
 
 @require_team_role()
diff --git a/tests/test_team_screen.py b/tests/test_team_screen.py
index b9bd836..3e49e47 100644
--- a/tests/test_team_screen.py
+++ b/tests/test_team_screen.py
@@ -1,5 +1,6 @@
 import unittest
 
+from app.screens.layout import page
 from tests.helpers import ADA, BO, DEE, TEAM, call, make_env
 
 SCREEN = f"/settings/teams/{TEAM}"
@@ -28,5 +29,16 @@ class TeamScreenTest(unittest.TestCase):
         self.assertEqual(status, 404)
 
 
+class LayoutScriptsTest(unittest.TestCase):
+    def test_page_loads_each_script_in_order(self):
+        html = page("Title", "<p>Body</p>", scripts=("one.js", "two.js"))
+        first = html.index('<script src="/static/one.js" defer></script>')
+        second = html.index('<script src="/static/two.js" defer></script>')
+        self.assertLess(first, second)
+
+    def test_page_without_scripts_has_no_script_tag(self):
+        self.assertNotIn("<script", page("Title", "<p>Body</p>"))
+
+
 if __name__ == "__main__":
     unittest.main()
-- 
