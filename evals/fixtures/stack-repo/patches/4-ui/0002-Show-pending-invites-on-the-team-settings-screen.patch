+class PendingInvitesSectionTest(unittest.TestCase):
+    def setUp(self):
+        self.conn, self.app = make_env()
+
+    def invite(self, email="new@example.com", role="viewer"):
+        return invite.create(self.conn, TEAM, email, role, ADA)
+
+    def screen(self, user_id=ADA):
+        status, html = call(self.app, "GET", SCREEN, user_id=user_id)
+        self.assertEqual(status, 200)
+        return html
+
+    def test_admin_sees_pending_invites(self):
+        row = self.invite()
+        html = self.screen()
+        self.assertIn("<h2>Pending invites</h2>", html)
+        self.assertIn(f'data-invite-id="{row["id"]}"', html)
+        for cell in ("new@example.com", "Viewer", "Ada", row["expires_at"][:10]):
+            self.assertIn(f"<td>{cell}</td>", html)
+        self.assertIn('<p class="muted js-empty" hidden>', html)
+
+    def test_newest_invite_is_listed_first(self):
+        self.invite("one@example.com")
+        self.invite("two@example.com")
+        html = self.screen()
+        self.assertLess(html.index("two@example.com"), html.index("one@example.com"))
+
+    def test_empty_state_when_there_are_none(self):
+        html = self.screen()
+        self.assertIn('<p class="muted js-empty">No pending invites.</p>', html)
+        self.assertIn('<table class="data-table" hidden>', html)
+
+    def test_revoked_invites_are_not_listed(self):
+        row = self.invite()
+        invite.revoke(self.conn, TEAM, row["id"])
+        self.assertNotIn("new@example.com", self.screen())
+
+    def test_members_and_viewers_do_not_see_invites(self):
+        self.invite()
+        for user_id in (BO, CY):
+            html = self.screen(user_id)
+            self.assertNotIn("Pending invites", html)
+            self.assertNotIn("new@example.com", html)
+
+    def test_invite_data_is_escaped(self):
+        self.invite('<b>"x"@example.com')
+        html = self.screen()
+        self.assertNotIn("<b>", html)
+        self.assertIn("&lt;b&gt;&quot;x&quot;@example.com", html)
+
+    def test_token_is_not_in_the_page(self):
+        row = self.invite()
+        self.assertNotIn(row["token"], self.screen())
+
+
