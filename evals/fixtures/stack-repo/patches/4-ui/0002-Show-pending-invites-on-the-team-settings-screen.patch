+"""Settings > Team: the pending invites section.
+
+Not a page of its own. ``team_members.py`` renders it below the members table,
+for admins only.
+"""
+
+from html import escape
+
+
+def _row(invite):
+    return f"""
+          <tr data-invite-id="{invite["id"]}" data-invite-email="{escape(invite["email"])}">
+            <td>{escape(invite["email"])}</td>
+            <td>{escape(invite["role"].capitalize())}</td>
+            <td>{escape(invite["invited_by_name"] or "")}</td>
+            <td>{escape(invite["expires_at"][:10])}</td>
+          </tr>"""
+
+
+def render(team_id, invites):
+    rows = "".join(_row(invite) for invite in invites)
+    # Both the note and the table are always in the page, one of them hidden,
+    # so the script can switch between them as invites come and go.
+    return f"""
+    <section id="team-invites" data-team-id="{team_id}">
+      <header class="section-header">
+        <h2>Pending invites</h2>
+      </header>
+      <p class="muted js-empty"{" hidden" if invites else ""}>No pending invites.</p>
+      <table class="data-table"{"" if invites else " hidden"}>
+        <thead>
+          <tr><th>Email</th><th>Role</th><th>Invited by</th><th>Expires</th></tr>
+        </thead>
+        <tbody>{rows}
+        </tbody>
+      </table>
+    </section>"""
