diff --git a/app/static/team_invites.js b/app/static/team_invites.js
new file mode 100644
index 0000000..a9c3af0
--- /dev/null
+++ b/app/static/team_invites.js
@@ -0,0 +1,105 @@
+// Settings > Team: invite someone by email and revoke pending invites, without a page reload.
+(function () {
+  const section = document.getElementById("team-invites");
+  if (!section) return;
+
+  const teamId = section.dataset.teamId;
+  const errorBox = section.querySelector(".error");
+  const form = section.querySelector(".js-invite-form");
+  const table = section.querySelector("table");
+  const emptyNote = section.querySelector(".js-empty");
+
+  function showError(message) {
+    errorBox.textContent = message;
+    errorBox.hidden = false;
+  }
+
+  function clearError() {
+    errorBox.hidden = true;
+    errorBox.textContent = "";
+  }
+
+  // Resolves to { data } when the request worked and { problem } when it did not.
+  async function send(method, path, body) {
+    const response = await fetch(`/api/teams/${teamId}/invites${path}`, {
+      method,
+      headers: body ? { "Content-Type": "application/json" } : {},
+      body: body ? JSON.stringify(body) : undefined,
+    });
+    const data = await response.json().catch(() => ({}));
+    if (response.ok) return { data };
+    return { problem: data.error || "Something went wrong. Try again." };
+  }
+
+  function refreshEmptyState() {
+    const empty = table.tBodies[0].rows.length === 0;
+    table.hidden = empty;
+    emptyNote.hidden = !empty;
+  }
+
+  function capitalize(text) {
+    return text.charAt(0).toUpperCase() + text.slice(1);
+  }
+
+  // Mirrors _row in app/screens/team_invites.py. Every value goes in through
+  // textContent or dataset, so nothing from the API is parsed as HTML.
+  function buildRow(invite) {
+    const row = document.createElement("tr");
+    row.dataset.inviteId = invite.id;
+    row.dataset.inviteEmail = invite.email;
+    const cells = [
+      invite.email,
+      capitalize(invite.role),
+      invite.invited_by || "",
+      invite.expires_at.slice(0, 10),
+    ];
+    for (const text of cells) {
+      row.insertCell().textContent = text;
+    }
+    const button = document.createElement("button");
+    button.type = "button";
+    button.className = "js-revoke link-danger";
+    button.textContent = "Revoke";
+    const actions = row.insertCell();
+    actions.className = "actions";
+    actions.append(button);
+    return row;
+  }
+
+  form.addEventListener("submit", async (event) => {
+    event.preventDefault();
+    clearError();
+    const submit = form.querySelector('button[type="submit"]');
+    submit.disabled = true;
+    const { data, problem } = await send("POST", "", {
+      email: form.elements.email.value,
+      role: form.elements.role.value,
+    });
+    submit.disabled = false;
+    if (problem) {
+      showError(problem);
+      return;
+    }
+    table.tBodies[0].prepend(buildRow(data.invite));
+    refreshEmptyState();
+    form.reset();
+    form.elements.email.focus();
+  });
+
+  section.addEventListener("click", async (event) => {
+    const button = event.target.closest(".js-revoke");
+    if (!button) return;
+    const row = button.closest("tr");
+    if (!window.confirm(`Revoke the invite for ${row.dataset.inviteEmail}?`)) return;
+    clearError();
+    button.disabled = true;
+    const { problem } = await send("DELETE", `/${row.dataset.inviteId}`);
+    if (problem) {
+      button.disabled = false;
+      showError(problem);
+    } else {
+      row.remove();
+      refreshEmptyState();
+    }
+  });
+})();
