Subject: [PATCH 1/2] Add the invite email

A template and the function that renders it onto the mail queue for one
invite. The link points at /invites/accept, which arrives with the
accept flow.
---
 app/mail/invite.py            | 18 ++++++++++++++++
 app/mail/templates/invite.txt | 13 ++++++++++++
 tests/test_invite_mail.py     | 40 +++++++++++++++++++++++++++++++++++
 3 files changed, 71 insertions(+)
 create mode 100644 app/mail/invite.py
 create mode 100644 app/mail/templates/invite.txt
 create mode 100644 tests/test_invite_mail.py

diff --git a/app/mail/invite.py b/app/mail/invite.py
new file mode 100644
index 0000000..be10732
--- /dev/null
+++ b/app/mail/invite.py
@@ -0,0 +1,18 @@
+"""The team invite email."""
+
+from app.mail import queue
+from app.mail.templates import render
+from app.models.invite import TTL_DAYS
+
+
+def send(conn, invite_row, base_url):
+    """Put the email for one invite on the mail queue."""
+    subject, body = render(
+        "invite",
+        inviter=invite_row["invited_by_name"] or "A teammate",
+        team=invite_row["team_name"],
+        role=invite_row["role"],
+        link=f"{base_url}/invites/accept?token={invite_row['token']}",
+        days=TTL_DAYS,
+    )
+    return queue.enqueue(conn, invite_row["email"], subject, body)
diff --git a/app/mail/templates/invite.txt b/app/mail/templates/invite.txt
new file mode 100644
