@@ -0,0 +1,13 @@
+Subject: $inviter invited you to join $team on Teamdesk
+
+Hi,
+
+$inviter has invited you to join the $team team on Teamdesk with the $role
+role. Use this link to accept:
+
+$link
+
+The invite works for $days days. If you were not expecting it, you can ignore
+this email and nothing will happen.
+
+Teamdesk
diff --git a/tests/test_invite_mail.py b/tests/test_invite_mail.py
new file mode 100644
index 0000000..5950a2e
--- /dev/null
+++ b/tests/test_invite_mail.py
@@ -0,0 +1,40 @@
+import unittest
+
+from app.mail import invite as invite_mail
+from app.mail import queue
+from app.models import invite
+from tests.helpers import ADA, DEE, TEAM, make_env
+
+BASE_URL = "https://teamdesk.test"
+
+
+class InviteMailCase(unittest.TestCase):
+    def setUp(self):
+        self.conn, _ = make_env()
+
+    def invite(self, email="new@example.com", role="member", invited_by=ADA):
+        return invite.create(self.conn, TEAM, email, role, invited_by)
+
+
+class InviteMessageTest(InviteMailCase):
+    def test_queues_a_message_for_the_invited_address(self):
+        row = self.invite(role="viewer")
+        invite_mail.send(self.conn, row, BASE_URL)
+        (message,) = queue.pending(self.conn)
+        self.assertEqual(message["to_email"], "new@example.com")
+        self.assertEqual(message["subject"], "Ada invited you to join Acme on Teamdesk")
+        self.assertIn(f"{BASE_URL}/invites/accept?token={row['token']}", message["body"])
+        self.assertIn("with the viewer", message["body"])
+        self.assertIn(f"{invite.TTL_DAYS} days", message["body"])
+
+    def test_inviter_who_has_since_been_deleted(self):
+        row = self.invite(invited_by=DEE)
+        self.conn.execute("DELETE FROM users WHERE id = ?", (DEE,))
+        self.conn.commit()
+        invite_mail.send(self.conn, invite.find(self.conn, TEAM, row["id"]), BASE_URL)
+        (message,) = queue.pending(self.conn)
+        self.assertEqual(message["subject"], "A teammate invited you to join Acme on Teamdesk")
+
+
+if __name__ == "__main__":
+    unittest.main()
