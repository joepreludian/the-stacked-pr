+"""JSON API for a team's invites. Admins only.
+
+Creating an invite only stores it. The email is queued later by the sweep in
+``app/mail``, so nothing here touches the mail queue.
+"""
+
+from app.auth import require_team_role
+from app.http import error, json_response, no_content
+from app.models import invite
+
+
+def _public(row):
+    # The token is the invited person's credential. It never leaves in a response.
+    return {
+        "id": row["id"],
+        "email": row["email"],
+        "role": row["role"],
+        "status": row["status"],
+        "invited_by": row["invited_by_name"],
+        "created_at": row["created_at"],
+        "expires_at": row["expires_at"],
+    }
+
+
+@require_team_role("admin")
+def list_invites(request):
+    rows = invite.list_for_team(request.conn, request.team_id, status="pending")
+    return json_response({"invites": [_public(row) for row in rows]})
+
+
+@require_team_role("admin")
+def revoke_invite(request):
+    raw = request.params.get("invite_id", "")
+    if not raw.isdigit():
+        return error(404, "Invite not found")
+    try:
+        revoked = invite.revoke(request.conn, request.team_id, int(raw))
+    except invite.NotPendingError:
+        return error(409, "Only a pending invite can be revoked")
+    if revoked is None:
+        return error(404, "Invite not found")
+    return no_content()
+
+
+def register(router):
+    router.add("GET", "/api/teams/<team_id>/invites", list_invites)
+    router.add("DELETE", "/api/teams/<team_id>/invites/<invite_id>", revoke_invite)
