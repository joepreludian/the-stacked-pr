+import unittest
+
+from app.models import invite
+from tests.helpers import ADA, BO, CY, DEE, TEAM, call, make_env
+
+INVITES = f"/api/teams/{TEAM}/invites"
+OTHER_TEAM = 2
+
+
+class InvitesApiCase(unittest.TestCase):
+    def setUp(self):
+        self.conn, self.app = make_env()
+
+    def invite(self, email="new@example.com", role="member", team_id=TEAM):
+        return invite.create(self.conn, team_id, email, role, ADA)
+
+
+class ListInvitesTest(InvitesApiCase):
+    def test_admin_lists_pending_invites_newest_first(self):
+        self.invite("one@example.com", "viewer")
+        self.invite("two@example.com")
+        status, body = call(self.app, "GET", INVITES, user_id=ADA)
+        self.assertEqual(status, 200)
+        self.assertEqual([i["email"] for i in body["invites"]], ["two@example.com", "one@example.com"])
+        self.assertEqual(
+            sorted(body["invites"][1]),
+            ["created_at", "email", "expires_at", "id", "invited_by", "role", "status"],
+        )
+        self.assertEqual(body["invites"][1]["role"], "viewer")
+        self.assertEqual(body["invites"][1]["invited_by"], "Ada")
+
+    def test_token_is_never_exposed(self):
+        row = self.invite()
+        _, body = call(self.app, "GET", INVITES, user_id=ADA)
+        self.assertNotIn(row["token"], str(body))
+
+    def test_revoked_invites_are_left_out(self):
+        row = self.invite()
+        invite.revoke(self.conn, TEAM, row["id"])
+        _, body = call(self.app, "GET", INVITES, user_id=ADA)
+        self.assertEqual(body["invites"], [])
+
+    def test_members_and_viewers_are_forbidden(self):
+        for user_id in (BO, CY):
+            status, _ = call(self.app, "GET", INVITES, user_id=user_id)
+            self.assertEqual(status, 403)
+
+    def test_requires_sign_in(self):
+        status, _ = call(self.app, "GET", INVITES)
+        self.assertEqual(status, 401)
+
+    def test_outsiders_cannot_tell_the_team_exists(self):
+        status, _ = call(self.app, "GET", INVITES, user_id=DEE)
+        self.assertEqual(status, 404)
+
+
+class RevokeInviteTest(InvitesApiCase):
+    def test_admin_revokes_an_invite(self):
+        row = self.invite()
+        status, _ = call(self.app, "DELETE", f"{INVITES}/{row['id']}", user_id=ADA)
+        self.assertEqual(status, 204)
+        self.assertEqual(invite.find(self.conn, TEAM, row["id"])["status"], "revoked")
+
+    def test_non_admin_is_forbidden(self):
+        row = self.invite()
+        status, _ = call(self.app, "DELETE", f"{INVITES}/{row['id']}", user_id=BO)
+        self.assertEqual(status, 403)
+        self.assertEqual(invite.find(self.conn, TEAM, row["id"])["status"], "pending")
+
+    def test_unknown_invite_is_not_found(self):
+        for invite_id in ("99", "abc"):
+            status, _ = call(self.app, "DELETE", f"{INVITES}/{invite_id}", user_id=ADA)
+            self.assertEqual(status, 404)
+
+    def test_invite_of_another_team_is_not_found(self):
+        self.conn.execute("INSERT INTO teams (id, name) VALUES (?, 'Globex')", (OTHER_TEAM,))
+        row = self.invite(team_id=OTHER_TEAM)
+        status, _ = call(self.app, "DELETE", f"{INVITES}/{row['id']}", user_id=ADA)
+        self.assertEqual(status, 404)
+
+    def test_revoking_twice_is_a_conflict(self):
+        row = self.invite()
+        call(self.app, "DELETE", f"{INVITES}/{row['id']}", user_id=ADA)
+        status, body = call(self.app, "DELETE", f"{INVITES}/{row['id']}", user_id=ADA)
+        self.assertEqual(status, 409)
+        self.assertIn("pending", body["error"])
+
+
+if __name__ == "__main__":
+    unittest.main()
