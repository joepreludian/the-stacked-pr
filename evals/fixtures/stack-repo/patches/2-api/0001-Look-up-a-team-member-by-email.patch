From f8942cc65488d4876a9a279a4fed9a87df8e2d97 Mon Sep 17 00:00:00 2001
From: Fixture <fixture@example.com>
Date: Fri, 2 Oct 2026 09:50:00 -0300
Subject: [PATCH 1/3] Look up a team member by email

The invite API needs to refuse inviting someone who is already on the
team, and it only has their address.
---
 app/models/membership.py  |  8 ++++++++
 tests/test_memberships.py | 16 ++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/app/models/membership.py b/app/models/membership.py
index 49f2b3b..5b0055b 100644
--- a/app/models/membership.py
+++ b/app/models/membership.py
@@ -33,6 +33,14 @@ def find_for_user(conn, team_id, user_id):
     return dict(row) if row else None
 
 
+def find_for_email(conn, team_id, email):
+    row = conn.execute(
+        _SELECT + " WHERE m.team_id = ? AND lower(u.email) = ?",
+        (team_id, email.strip().lower()),
+    ).fetchone()
+    return dict(row) if row else None
+
+
 def add(conn, team_id, user_id, role="member"):
     if role not in ROLES:
         raise ValueError(f"Unknown role: {role}")
diff --git a/tests/test_memberships.py b/tests/test_memberships.py
index a116ffa..ae856c0 100644
--- a/tests/test_memberships.py
+++ b/tests/test_memberships.py
@@ -1,5 +1,6 @@
 import unittest
 
+from app.models import membership
 from tests.helpers import ADA, BO, CY, DEE, TEAM, call, make_env
 
 MEMBERS = f"/api/teams/{TEAM}/members"
@@ -70,5 +71,20 @@ class RemoveMemberTest(unittest.TestCase):
         self.assertEqual(status, 404)
 
 
+class FindForEmailTest(unittest.TestCase):
+    def setUp(self):
+        self.conn, self.app = make_env()
+
+    def test_finds_a_member_whatever_the_case(self):
+        member = membership.find_for_email(self.conn, TEAM, "Bo@Example.com")
+        self.assertEqual((member["user_id"], member["role"]), (BO, "member"))
+
+    def test_user_outside_the_team_is_none(self):
+        self.assertIsNone(membership.find_for_email(self.conn, TEAM, "dee@example.com"))
+
+    def test_unknown_address_is_none(self):
+        self.assertIsNone(membership.find_for_email(self.conn, TEAM, "nobody@example.com"))
+
+
 if __name__ == "__main__":
     unittest.main()
